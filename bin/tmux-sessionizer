#!/usr/bin/env bash

set -euo pipefail

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required."
  exit 1
fi

ROOTS=("$HOME/Projects" "$HOME/work" "$HOME/src")

dirs=()
for root in "${ROOTS[@]}"; do
  [[ -d "$root" ]] && dirs+=( "$root" )
done

target=$(find "${dirs[@]}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | fzf --prompt="session> " ) || exit 0
session_name=$(basename "$target" | tr . _)

if ! tmux has-session -t "$session_name" 2>/dev/null; then
  tmux new-session -d -s "$session_name" -c "$target"
fi

tmux attach-session -t "$session_name"
