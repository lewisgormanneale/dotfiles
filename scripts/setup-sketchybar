#!/usr/bin/env bash
set -euo pipefail

# sketchybar post-installation setup
# Installs SbarLua, downloads sketchybar-app-font, and compiles helper binaries

DOTROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_DIR="$HOME/.config/sketchybar"

echo "Setting up SketchyBar with Lua configuration..."

# Install SbarLua (sketchybar Lua bindings)
install_sbarlua() {
  if [ -d "$HOME/.local/share/sketchybar_lua" ]; then
    echo "✓ SbarLua already installed"
    return
  fi

  echo "Installing SbarLua..."
  git clone https://github.com/FelixKratz/SbarLua.git /tmp/SbarLua
  (cd /tmp/SbarLua && make install)
  rm -rf /tmp/SbarLua
  echo "✓ SbarLua installed successfully"
}

# Download sketchybar-app-font
install_app_font() {
  if [ -f "$HOME/Library/Fonts/sketchybar-app-font.ttf" ]; then
    echo "✓ sketchybar-app-font already installed"
    return
  fi

  echo "Downloading sketchybar-app-font..."
  curl -L https://github.com/kvndrsslr/sketchybar-app-font/releases/download/v2.0.28/sketchybar-app-font.ttf \
    -o "$HOME/Library/Fonts/sketchybar-app-font.ttf"
  echo "✓ sketchybar-app-font installed"
}

# Compile helper binaries (if makefiles exist)
compile_helpers() {
  if [ ! -d "$CONFIG_DIR/helpers" ]; then
    echo "No helpers directory found, skipping compilation"
    return
  fi

  echo "Compiling helper binaries..."
  if [ -f "$CONFIG_DIR/helpers/makefile" ] || [ -f "$CONFIG_DIR/helpers/Makefile" ]; then
    (cd "$CONFIG_DIR/helpers" && make 2>/dev/null) || echo "ℹ️  Helper compilation skipped (optional)"
  fi
}

# Restart sketchybar
restart_sketchybar() {
  echo "Restarting SketchyBar..."
  brew services restart sketchybar 2>/dev/null || sketchybar --reload || true
  echo "✓ SketchyBar restarted"
}

validate_config() {
  if [[ ! -f "$CONFIG_DIR/sketchybarrc" ]]; then
    echo "⚠️  Config file not found at $CONFIG_DIR/sketchybarrc"
    echo "   Please ensure config is linked: make link"
    return 1
  fi
  echo "✓ SketchyBar config found"
}

main() {
  # Ensure sketchybar is installed
  if ! command -v sketchybar &>/dev/null; then
    echo "✗ sketchybar not found. Install with: brew install sketchybar"
    return 1
  fi

  install_sbarlua
  install_app_font
  validate_config
  compile_helpers
  restart_sketchybar

  echo ""
  echo "✅ SketchyBar setup complete!"
  echo "Config location: $CONFIG_DIR"
  echo ""
  echo "ℹ️  To reload config after making changes:"
  echo "   brew services restart sketchybar"
  echo "   or: sketchybar --reload"
}

main "$@"
