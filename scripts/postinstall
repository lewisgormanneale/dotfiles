#!/usr/bin/env bash
set -euo pipefail

DOTROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

run_macos_defaults() {
  local defaults_script="$DOTROOT/macos/defaults.sh"
  if is_macos && [[ -x "$defaults_script" ]]; then
    echo "Applying macOS defaults..."
    "$defaults_script"
  else
    echo "macOS defaults script not present; skipping."
  fi
}

setup_sketchybar() {
  local sketchybar_script="$DOTROOT/scripts/setup-sketchybar"
  if is_macos && [[ -x "$sketchybar_script" ]]; then
    echo ""
    echo "=== Setting up sketchybar ==="
    "$sketchybar_script"
  fi
}

customize_kitty_icon() {
  if ! is_macos; then
    return
  fi

  local kitty_app="/Applications/kitty.app"
  if [[ ! -d "$kitty_app" ]]; then
    echo "Kitty not installed, skipping icon customization"
    return
  fi

  local custom_icon="$DOTROOT/assets/icons/kitty.icns"
  if [[ ! -f "$custom_icon" ]]; then
    echo "Custom Kitty icon not found at $custom_icon, skipping"
    return
  fi

  echo ""
  echo "=== Customizing Kitty icon ==="

  # Replace the icon with the custom one
  if [[ -f "${kitty_app}/Contents/Resources/kitty.icns" ]]; then
    sudo cp "$custom_icon" "${kitty_app}/Contents/Resources/kitty.icns"
    # Clear icon cache to refresh
    sudo rm -rf /Library/Caches/com.apple.iconservices.store
    sudo find /private/var/folders/ -name com.apple.iconservices -exec rm -rf {} \; 2>/dev/null || true
    killall Dock 2>/dev/null || true
    echo "✓ Kitty icon updated (Dock will restart)"
  fi
}

set_login_shell() {
  local zsh_path
  zsh_path="$(command -v zsh || true)"

  if [[ -z "$zsh_path" ]]; then
    return
  fi

  # Get current login shell using dscl (macOS)
  local current_shell
  current_shell=$(dscl . -read /Users/"$USER" UserShell 2>/dev/null | awk '{print $2}' || echo "")

  if [[ "$current_shell" == "$zsh_path" ]]; then
    echo "Login shell is already set to $zsh_path"
    return
  fi

  echo "Setting login shell to $zsh_path"
  # Ensure the shell is in /etc/shells (required on macOS for chsh)
  if ! grep -q "^${zsh_path}$" /etc/shells; then
    echo "Adding $zsh_path to /etc/shells"
    echo "$zsh_path" | sudo tee -a /etc/shells > /dev/null
  fi
  chsh -s "$zsh_path"
}

main() {
  run_macos_defaults
  set_login_shell
  customize_kitty_icon
  setup_sketchybar
}

main "$@"
