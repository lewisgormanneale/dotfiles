#!/usr/bin/env bash
set -euo pipefail

DOTROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

run_macos_defaults() {
  local defaults_script="$DOTROOT/macos/defaults.sh"
  if is_macos && [[ -x "$defaults_script" ]]; then
    echo "Applying macOS defaults..."
    "$defaults_script"
  else
    echo "macOS defaults script not present; skipping."
  fi
}

set_login_shell() {
  local zsh_path
  zsh_path="$(command -v zsh || true)"
  if [[ -n "$zsh_path" ]] && [[ "$SHELL" != "$zsh_path" ]]; then
    echo "Setting login shell to $zsh_path"
    # Ensure the shell is in /etc/shells (required on macOS for chsh)
    if ! grep -q "^${zsh_path}$" /etc/shells; then
      echo "Adding $zsh_path to /etc/shells"
      echo "$zsh_path" | sudo tee -a /etc/shells > /dev/null
    fi
    chsh -s "$zsh_path"
  fi
}

main() {
  run_macos_defaults
  set_login_shell
}

main "$@"
