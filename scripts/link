#!/usr/bin/env bash
set -euo pipefail

DOTROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_TARGET="${XDG_CONFIG_HOME:-$HOME/.config}"
BIN_TARGET="$HOME/bin"

backup() {
  local target="$1"
  if [[ -e "$target" && ! -L "$target" ]]; then
    local ts
    ts=$(date +"%Y%m%d-%H%M%S")
    mv "$target" "${target}.bak-${ts}"
    echo "Backed up $target -> ${target}.bak-${ts}"
  elif [[ -L "$target" ]]; then
    rm -f "$target"
  fi
}

link_path() {
  local src="$1"
  local dest="$2"
  backup "$dest"
  mkdir -p "$(dirname "$dest")"
  ln -s "$src" "$dest"
  echo "Linked $dest -> $src"
}

link_config_dir() {
  local name="$1"
  link_path "$DOTROOT/config/$name" "$CONFIG_TARGET/$name"
}

main() {
  mkdir -p "$CONFIG_TARGET"
  mkdir -p "$BIN_TARGET"

  # Core configs
  for dir in zsh git starship tmux ghostty nvim aerospace sketchybar; do
    [[ -d "$DOTROOT/config/$dir" ]] && link_config_dir "$dir"
  done

  # Home dotfiles
  link_path "$DOTROOT/config/zsh/.zshrc" "$HOME/.zshrc"
  link_path "$DOTROOT/config/zsh/.zprofile" "$HOME/.zprofile"
  link_path "$DOTROOT/config/git/.gitconfig" "$HOME/.gitconfig"

  # Bin scripts
  for script in "$DOTROOT"/bin/*; do
    [[ -f "$script" ]] && link_path "$script" "$BIN_TARGET/$(basename "$script")"
  done

  # Optional extras
  [[ -f "$DOTROOT/.editorconfig" ]] && link_path "$DOTROOT/.editorconfig" "$HOME/.editorconfig"
}

main "$@"
